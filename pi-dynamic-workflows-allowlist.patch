+/** Match an allowlist identifier against Pi's extension source metadata. */
+export function matchesEnabledExtension(
+  extension: { path: string; sourceInfo: { source?: string; baseDir?: string } },
+  enabledExtensions: string[],
+): boolean {
+  if (!enabledExtensions.length) return false;
+  const source = extension.sourceInfo.source ?? "";
+  const baseDir = extension.sourceInfo.baseDir ?? "";
+  return enabledExtensions.some((identifier) => {
+    const normalized = identifier.trim();
+    if (!normalized) return false;
+    if (source === normalized || source === `npm:${normalized}` || source.endsWith(`/${normalized}`)) return true;
+    return (
+      extension.path.startsWith(`${baseDir}/${normalized}/`) ||
+      extension.path.startsWith(`${baseDir}/${normalized}.`) ||
+      extension.path.startsWith(`${baseDir}/extensions/${normalized}/`)
+    );
+  });
+}
