{
  "enabled": true,
  "accel": "tcg",
  "guestWorkspace": "/workspace",
  "allowedHosts": null,
  "envPassthrough": ["TZ"],
  "mounts": {
    "skills": "ro",
    "~/reference-docs": { "access": "rw", "guestPath": "/docs" }
  },
  "httpProxy": {
    "enabled": true,
    "discoverKnownSecrets": true,
    "secrets": {
      "MY_SERVICE_TOKEN": {
        "hosts": ["api.myservice.com", "*.myservice.dev"],
        "envVar": "MY_SERVICE_TOKEN"
      }
    }
  }
}
