{
  "name": "pi-packages",
  "version": "0.1.0",
  "description": "Pi extensions for file guards, routed workers, configurable MCP clients, thinking compression, a Gondolin micro-VM sandbox, and sandboxed radare2 binary analysis",
  "keywords": [
    "pi-package",
    "pi",
    "mcp",
    "workers",
    "file-guard",
    "thinking-compression",
    "gondolin",
    "sandbox",
    "qemu",
    "radare2",
    "r2pipe",
    "reverse-engineering"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "npx --yes --package typescript tsc --noEmit -p tsconfig.mcp.json",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test",
    "test:pi": "npm run build && node --test test/workers-bundle.test.mjs test/gondolin-bundle.test.mjs test/radare2-bundle.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./dist/file-guard",
      "./dist/mcp-client",
      "./dist/workers",
      "./dist/thinking-compression",
      "./dist/gondolin",
      "./dist/radare2"
    ],
    "skills": [
      "./dist/radare2/skills/radare2"
    ]
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0"
  }
}
