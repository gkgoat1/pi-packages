{
  "name": "@gkgo/pi-packages",
  "version": "0.3.0",
  "description": "Pi extensions for file guards, routed resumable workers with a TUI dashboard, thinking compression, a Gondolin micro-VM sandbox, sandboxed radare2 binary analysis, and configurable tool-output limits",
  "keywords": [
    "pi-package",
    "pi",
    "workers",
    "file-guard",
    "thinking-compression",
    "gondolin",
    "sandbox",
    "qemu",
    "radare2",
    "r2pipe",
    "reverse-engineering",
    "tool-output"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkgoat1/pi-packages.git"
  },
  "homepage": "https://github.com/gkgoat1/pi-packages",
  "bugs": "https://github.com/gkgoat1/pi-packages/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "extensions/",
    "examples/",
    "docs/deferred-migrations.md",
    "!**/*.test.ts",
    "!**/test/**",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.extensions.json",
    "build": "node scripts/build.mjs",
    "test": "node --import tsx --test",
    "test:pi": "npm run build && node --test test/workers-bundle.test.mjs test/gondolin-bundle.test.mjs test/radare2-bundle.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/chord": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-durable": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@earendil-works/chord": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-durable": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/chord": {
      "optional": true
    },
    "@earendil-works/pi-durable": {
      "optional": true
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./file-guard/durable": "./dist/file-guard/durable.js",
    "./thinking-compression/durable": "./dist/thinking-compression/durable.js",
    "./tool-output-limit/durable": "./dist/tool-output-limit/durable.js"
  },
  "pi": {
    "extensions": [
      "./dist/file-guard",
      "./dist/workers",
      "./dist/thinking-compression",
      "./dist/gondolin",
      "./dist/radare2",
      "./dist/tool-output-limit"
    ],
    "skills": [
      "./dist/radare2/skills/radare2"
    ]
  },
  "dependencies": {
    "@earendil-works/gondolin": "^0.12.0"
  }
}
